
<div class="no-print">
    <button class="btn btn-primary update" @onclick="OnClick">@Label</button>
    <a class="btn btn-secondary update" href="/">Menu</a>
    </div>

@code {
    [Parameter, EditorRequired] public EventCallback OnClick { get; set; }
    [Parameter] public string Label { get; set; } = "Refresh report";
}
